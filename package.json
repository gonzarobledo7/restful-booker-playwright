{
  "name": "restful-booker-playwright",
  "version": "0.1.0",
  "private": true,
  "description": "API, UI and E2E test automation for Restful Booker Platform with Playwright + TypeScript.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "app:up": "docker compose up -d --wait",
    "app:down": "docker compose down --volumes",
    "app:logs": "docker compose logs --tail=200",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui-chromium",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
